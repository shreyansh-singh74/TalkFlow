# TalkFlow Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (for coach replies and practice-script generation)
# Get it from: https://openrouter.ai/keys
# Optional: without it, coach replies fall back to canned lines and generated
# scripts fall back to the offline bank in app/services/practice_content.py.
OPENROUTER_API_KEY=

# Google Cloud Credentials (for Text-to-Speech)
# Option 1: Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json

# Option 2: Base64 encoded JSON (for cloud deployments like Railway)
# GOOGLE_CREDENTIALS_JSON=base64_encoded_json_here

# Frontend URL (for CORS)
# FRONTEND_URL=https://your-frontend-domain.com
