# TalkFlow backend environment variables
# Copy to `.env` and fill in your values.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "production" disables the localhost CORS convenience regex. Leave unset for
# local development.
# ENVIRONMENT=production

# ---------------------------------------------------------------------------
# WebSocket authentication
# ---------------------------------------------------------------------------
# Must match WS_TOKEN_SECRET in web/.env (openssl rand -hex 32).
# With WS_AUTH_REQUIRED=1 an empty secret means every voice connection is
# refused -- fail closed, and loud about it in the startup log.
WS_AUTH_REQUIRED=1
WS_TOKEN_SECRET=
# WS_TOKEN_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Server-to-server authentication
# ---------------------------------------------------------------------------
# Shared secret with the web app's INTERNAL_API_TOKEN. Required on the routes
# that spend money on your behalf (/api/practice/script -> OpenRouter, and the
# audio purge). Empty means those routes accept any caller, and the startup log
# says so.
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# LLM (OpenRouter)
# ---------------------------------------------------------------------------
# https://openrouter.ai/settings/keys
# Optional: without it, coach replies fall back to canned lines and generated
# scripts fall back to the offline bank in app/services/practice_content.py.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.2-3b-instruct:free,qwen/qwen-2.5-7b-instruct:free

# ---------------------------------------------------------------------------
# Text-to-speech (Google Cloud)
# ---------------------------------------------------------------------------
# Option 1: path to a service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json
# Option 2: base64-encoded JSON, for platforms with no writable disk
# GOOGLE_CREDENTIALS_JSON=

# Frontend origin, for CORS
# FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Speech models
# ---------------------------------------------------------------------------
# WavLM-Large needs ~3.6 GB RSS with both models resident. On a 4 GB host use
# the base-plus checkpoint: it is 2.9x faster and leaves the pronunciation
# score unchanged (the score comes from the waveform, not the transcript).
# ASR_MODEL_ID=patrickvonplaten/wavlm-libri-clean-100h-large
# ASR_MODEL_ID=patrickvonplaten/wavlm-libri-clean-100h-base-plus
# ACOUSTIC_PHONEME_MODEL_ID=vitouphy/wav2vec2-xls-r-300m-timit-phoneme
ENABLE_ASR=1
WARM_ASR_ON_STARTUP=1
ENABLE_ACOUSTIC_SCORING=1
WARM_ACOUSTIC_ON_STARTUP=1
# Set to 0 to defer the phoneme model and cut peak memory.
# ACOUSTIC_PHONEME_MODEL_ID=

# ---------------------------------------------------------------------------
# Scoring & limits
# ---------------------------------------------------------------------------
# 15s of 16 kHz mono PCM16. A learner-paced practice sentence runs 6-10s.
TURN_AUDIO_MAX_BYTES=480000
# A phone counts as correct at or below this articulatory distance.
# CORRECT_DISTANCE_THRESHOLD=0.34
# Bound a hung forward pass (~3x the measured warm phoneme pass on 2 vCPUs).
# SCORE_TIMEOUT_SECONDS=20
# ASR_TIMEOUT_SECONDS=120
# MAX_TURNS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Accent-aware scoring + L1-aware coaching
# ---------------------------------------------------------------------------
# The accent the scorer compares against when a session does not name one.
# Profiles live in app/services/pronunciation/accents.py: en-US is rhotic,
# en-GB/en-AU drop coda /r/ (so a British learner is not charged for the /r/ in
# "party"), en-IN is rhotic with a neutralised vowel length contrast.
# TARGET_ACCENT=en-US
# When on, the learner's first language (user_settings.native_language) biases
# which sounds the coach names and what generated content targets. It never
# changes a score -- see app/services/l1_profiles.py.
# L1_AWARE_ENABLED=1
# Prosody: stress/timing (dimensions B/C) and intonation (D). Each dimension
# reports None when it cannot be measured, so the report never invents a number.
# ENABLE_PROSODY_SCORING=1
# ENABLE_INTONATION_SCORING=1

# ---------------------------------------------------------------------------
# Raw turn audio (consent-gated; off by default)
# ---------------------------------------------------------------------------
# Nothing is written to disk unless this is enabled. Files are swept after
# TURN_AUDIO_RETENTION_HOURS, and a learner can delete theirs from Settings.
# Both this flag AND the learner's own opt-in are required before a turn is
# written.
# PERSIST_TURN_AUDIO=0
# TURN_AUDIO_DIR=/tmp/talkflow_audio
# TURN_AUDIO_RETENTION_HOURS=24
