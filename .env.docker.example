# Copy to `.env.docker` (compose reads that file automatically) and fill in what
# you have. Everything except the two shared secrets is optional: the stack
# starts without any of it, and the app says which capability is missing instead
# of failing silently.
#
#   cp .env.docker.example .env.docker
#   openssl rand -hex 32   # twice: one for each secret below
#   docker compose up
#
# Then open http://localhost:3000.

# ---------------------------------------------------------------------------
# Required: the shared secret between web and backend
# ---------------------------------------------------------------------------
# The web app signs the short-lived voice token with this and the backend
# verifies it. If the two values differ, the microphone never connects.
#   openssl rand -hex 32
WS_TOKEN_SECRET=

# Better Auth's session secret. Any long random string for local use.
BETTER_AUTH_SECRET=

# The web app's shared secret for server-to-server backend calls. It guards
# /api/practice/*, which spends OpenRouter credit on your account. Generate your
# own:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional: subscriptions (Stripe test mode)
# ---------------------------------------------------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Without them
# the app runs on the free tier (10 sessions a month) and the upgrade buttons
# say that billing is not configured.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints this.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional: spoken coach replies and generated practice content
# ---------------------------------------------------------------------------
# Without it: coach replies fall back to canned lines and scripts come from the
# offline bank (the UI labels them as generic), so the flow still works.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: text-to-speech (spoken reference audio + coach replies)
# ---------------------------------------------------------------------------
# Mount a Google service-account JSON into the backend container:
#   docker compose run -v /path/to/gcp.json:/run/secrets/google-credentials.json:ro backend ...
# or add the mount to the backend service's `volumes:` list in
# docker-compose.yml.
# GOOGLE_APPLICATION_CREDENTIALS_FILE=/path/to/gcp.json

# ---------------------------------------------------------------------------
# Optional: OAuth + password-reset email
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Low-memory hosts
# ---------------------------------------------------------------------------
# WavLM-Large plus the phoneme model peak at ~3.6 GB. On a 4 GB machine, use:
#   ASR_MODEL_ID=patrickvonplaten/wavlm-libri-clean-100h-base-plus
# which is ~2.9 GB and 2.9x faster, and leaves the pronunciation score
# unchanged -- only the displayed transcript degrades.
