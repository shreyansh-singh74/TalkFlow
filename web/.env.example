# TalkFlow web app — copy to `.env` and fill in.
#
# This file listed GEMINI_API_KEY and two Stream-video variables that no longer
# appear anywhere in the source (the LLM moved behind the backend's OpenRouter
# client). It also sat in .gitignore, so nobody could see it. Both are fixed.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/talkflow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI service. The browser opens this directly for the voice WebSocket and
# for the phoneme/reference endpoints, so it must be reachable from the client.
# In a deployment this is the *public* address of the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional, server-side only: where the Next.js server reaches FastAPI.
# Set it when the browser and the server need different addresses -- a private
# network, a container name, an internal ingress -- so the public URL the browser
# dials is not also the one the server has to be able to open. When unset, the
# server reuses NEXT_PUBLIC_BACKEND_URL. Never expose this to the client, which
# is why it takes no NEXT_PUBLIC_ prefix.
# BACKEND_URL=http://backend:8000

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Voice WebSocket tokens
# ---------------------------------------------------------------------------
# Shared secret with the backend's WS_TOKEN_SECRET. The web app signs a
# short-lived {userId, sessionId, expiry} token that /ws/voice verifies, because
# a WebSocket handshake cannot carry the session cookie. Generate once and set
# the same value in both .env files (openssl rand -hex 32).
#
# Leave it empty and the backend refuses voice connections when
# WS_AUTH_REQUIRED=1 -- which is the default. For local development you can
# instead set WS_AUTH_REQUIRED=0 on the backend.
WS_TOKEN_SECRET=

# Token lifetime in seconds. Only needs to outlive the reconnect backoff; the
# client mints a fresh one on every connect attempt.
# WS_TOKEN_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Server-to-server calls to the FastAPI backend
# ---------------------------------------------------------------------------
# Shared secret with the backend's INTERNAL_API_TOKEN. Script generation spends
# OpenRouter credit, so the backend requires this header on /api/practice/*.
# Server-side only: never a NEXT_PUBLIC_* var, or it would ship to the browser.
#   openssl rand -hex 32
# Leave empty for local development and the backend will warn that those routes
# are open.
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Billing (optional; the app runs on the free tier without it)
# ---------------------------------------------------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# The price for the Pro subscription (test mode).
# STRIPE_PRO_PRICE_ID=price_...
# Run `stripe listen --forward-to localhost:3000/api/stripe/webhook` and paste
# the signing secret it prints. Without it the webhook refuses every event.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Password-reset email (optional)
# ---------------------------------------------------------------------------
# Without these, reset requests are logged and skipped rather than delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
